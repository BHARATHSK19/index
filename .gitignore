# ==============================================================================
# OJIX Production Git Ignore
# ==============================================================================

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and Secrets (CRITICAL: Never commit to git)
.env
.env.local
.env.*.local
.env.production
.env.development
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Local Database & User Inquiries (Statutory DPDP Confidentiality)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.json
data/backups/
!data/.gitkeep

# macOS & Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Build & Temporary Files
dist/
build/
.cache/
tmp/
temp/

# Firebase Cache & Deployment Logs
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
